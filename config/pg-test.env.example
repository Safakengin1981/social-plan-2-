# SocialPlan isolated PostgreSQL + R2 test configuration
# Template only. NEVER commit real credentials or paste them in chat.
# Use an EMPTY Neon Free test project. TLS is mandatory.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Cloudflare R2 Standard private bucket, isolated from production.
SOCIALPLAN_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
SOCIALPLAN_S3_BUCKET=socialplan-v58-test-private
SOCIALPLAN_S3_ACCESS_KEY=REPLACE_WITH_SECRET
SOCIALPLAN_S3_SECRET_KEY=REPLACE_WITH_SECRET
SOCIALPLAN_S3_REGION=auto

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIALPLAN_FERNET_KEY=REPLACE_WITH_FERNET_KEY
